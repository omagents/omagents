{
  "name": "@omagents/omagents-dsh",
  "version": "0.17.1",
  "description": "DeepSeek Harness host integration for OmAgents",
  "author": "OmAgents",
  "homepage": "https://github.com/omagents/omagents/tree/main/packages/dsh#readme",
  "type": "module",
  "main": "./dist/host/index.js",
  "types": "./dist/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./typert": {
      "types": "./dist/host/typert.d.ts",
      "default": "./dist/host/typert.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config tsdown.client.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/run.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.3 <0.2.3-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "omagents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omagents/omagents",
    "directory": "packages/dsh"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.3",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3",
    "@omagents/core": "0.17.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.3",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.3",
    "@deepseek-ai/dsh-mcp-manager": "0.2.2-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-loader": "0.2.2-rc.3",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.3",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.10.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "js-yaml": "4.3.2",
    "jsdom": "^27.4.0",
    "node-addon-require-builtin": "0.1.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
